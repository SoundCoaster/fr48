{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the name of the Worker connected to the GitHub repo in the Cloudflare dashboard
  "name": "fr48",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fr48"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRAFFIC", "class_name": "TrafficTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrafficTracker"] }],
  "observability": { "enabled": true }
}
